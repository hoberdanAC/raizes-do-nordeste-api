    {
      "name": "03 - Pedidos",
      "item": [
        {
          "name": "T03 - Criar pedido válido (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"unidadeId\": 1,\n  \"itens\": [\n    {\n      \"produtoId\": 1,\n      \"quantidade\": 2\n    },\n    {\n      \"produtoId\": 4,\n      \"quantidade\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Status inicial AGUARDANDO_PAGAMENTO\", () => pm.expect(j.status).to.eql(\"AGUARDANDO_PAGAMENTO\"));",
                  "pm.test(\"canalPedido registrado\", () => pm.expect(j.canalPedido).to.eql(\"APP\"));",
                  "pm.test(\"Total calculado pelo servidor (46.80)\", () => pm.expect(j.total).to.eql(46.8));",
                  "pm.collectionVariables.set(\"pedidoId\", j.pedidoId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar pedido criado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "T04 - Listar pedidos filtrando por canal (APP)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos?canalPedido=APP&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ],
              "query": [
                {
                  "key": "canalPedido",
                  "value": "APP"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos são APP\", () => pm.response.json().itens.forEach(p => pm.expect(p.canalPedido).to.eql(\"APP\")));"
                ]
              }
            }
          ]
        }
