# Copie para .env (ou exporte as variáveis no terminal) antes de iniciar a API.
# Nenhum segredo real deve ser versionado no Git.

# Porta HTTP da API
SERVER_PORT=8080

# Segredo do JWT: mínimo de 32 caracteres. TROQUE em qualquer ambiente real.
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32+-caracteres
# Validade do token em segundos (3600 = 1 hora)
JWT_EXPIRATION_SECONDS=3600

# Banco padrão: H2 em arquivo (./data). Para PostgreSQL, use SPRING_PROFILES_ACTIVE=postgres
SPRING_PROFILES_ACTIVE=
DB_URL=jdbc:postgresql://localhost:5432/raizes
DB_USER=raizes
DB_PASSWORD=raizes
